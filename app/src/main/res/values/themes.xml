<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Awakened" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy_deep</item>
        <item name="android:statusBarColor">@color/navy_deep</item>
        <item name="android:navigationBarColor">@color/navy_deep</item>
    </style>

    <style name="Theme.Awakened.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.Awakened</item>
    </style>

    <style name="Theme.Awakened.Penalty" parent="Theme.Awakened">
        <item name="android:windowBackground">#1A0006</item>
        <item name="android:statusBarColor">#1A0006</item>
        <item name="android:navigationBarColor">#1A0006</item>
    </style>
</resources>
